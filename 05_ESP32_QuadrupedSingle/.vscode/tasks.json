{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Single: Build",
      "type": "process",
      "command": "${workspaceFolder}/../.tools/Scripts/python.exe",
      "args": [
        "-m",
        "platformio",
        "run",
        "-e",
        "single_esp32"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Single: Upload",
      "type": "process",
      "command": "${workspaceFolder}/../.tools/Scripts/python.exe",
      "args": [
        "-m",
        "platformio",
        "run",
        "-e",
        "single_esp32",
        "-t",
        "upload",
        "--upload-port",
        "${input:serialPort}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Single: Serial monitor",
      "type": "process",
      "command": "${workspaceFolder}/../.tools/Scripts/python.exe",
      "args": [
        "-m",
        "platformio",
        "device",
        "monitor",
        "-p",
        "${input:serialPort}",
        "-b",
        "115200",
        "--echo",
        "--eol",
        "LF",
        "--filter",
        "send_on_enter"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Single: Open web console",
      "type": "process",
      "command": "${workspaceFolder}/../.tools/Scripts/python.exe",
      "args": [
        "tools/web_panel.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Actual single ESP32 COM port, e.g. COM13 (no spaces)",
      "default": "COM"
    }
  ]
}